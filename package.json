{
  "name": "highlander-today",
  "version": "1.0.0",
  "description": "A multi-tenant community news platform",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-theme-manifests.js",
    "prebuild": "node scripts/generate-theme-manifests.js",
    "prestart": "node scripts/generate-theme-manifests.js",
    "pretypecheck": "node scripts/generate-theme-manifests.js",
    "prelint": "node scripts/generate-theme-manifests.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "next dev",
    "build": "prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern='tests/unit'",
    "test:integration": "jest --testPathPattern='tests/integration'",
    "test:e2e": "jest --testPathPattern='tests/e2e'",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "analytics:rollup": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/aggregate-analytics.ts",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:create-super-admin": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/create-super-admin.ts",
    "db:backfill-tenant-domains": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/backfill-tenant-domains.ts",
    "db:set-user-dob": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/set-user-dob.ts",
    "deploy:check-env": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/check-deployment-env.ts",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "reporter:collect:local": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/reporter-local-browser-collector.ts",
    "reporter:worker:local-browser": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/reporter-local-browser-collector.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@prisma/client": "^5.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "d3": "^7.8.5",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.309.0",
    "next": "^15.5.24",
    "next-auth": "^4.24.15",
    "postcss": "8.5.28",
    "react": "^18.2.0",
    "react-calendar": "^4.2.1",
    "react-dom": "^18.2.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3": "^7.4.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.5.24",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "prettier": "^3.1.0",
    "prisma": "^5.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
